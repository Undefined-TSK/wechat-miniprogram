{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "allowJs": false,
    "removeComments": true,
    "skipLibCheck": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "typeRoots": ["./typings"],
    "baseUrl": "."
  },
  "include": ["miniprogram/**/*.ts", "typings/**/*.d.ts"],
  "exclude": ["node_modules", "tests", "docs"]
}
