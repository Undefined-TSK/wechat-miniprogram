.opts {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.opt {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  min-height: 104rpx;
  padding: var(--sp-3);
  border-radius: var(--r-lg);
  background-color: var(--c-bg-card);
  border: 2rpx solid var(--c-border);
  transition: border-color 120ms ease, background-color 120ms ease;
}

.opt.is-selected {
  border-color: var(--c-primary);
  background-color: var(--c-primary-weak);
}

.opt.is-right {
  border-color: var(--c-success);
  background-color: var(--c-success-weak);
}

.opt.is-wrong {
  border-color: var(--c-danger);
  background-color: var(--c-danger-weak);
}

.opt-key {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: var(--r-sm);
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--c-text-2);
  background-color: var(--c-bg-sunken);
}

.is-selected .opt-key {
  background-color: var(--c-primary);
  color: #ffffff;
}

.is-right .opt-key {
  background-color: var(--c-success);
  color: #ffffff;
}

.is-wrong .opt-key {
  background-color: var(--c-danger);
  color: #ffffff;
}

.opt-text {
  flex: 1;
  font-size: var(--fs-md);
  line-height: 1.6;
  color: var(--c-text);
}

.opt-mark {
  flex: none;
  font-size: var(--fs-lg);
  font-weight: 500;
  color: var(--c-text-3);
}

.is-right .opt-mark {
  color: var(--c-success);
}

.is-wrong .opt-mark {
  color: var(--c-danger);
}
