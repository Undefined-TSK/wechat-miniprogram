.state {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--sp-3);
}

.back-btn {
  margin-top: var(--sp-2);
}

/* ------------------------------ 顶部进度 ------------------------------ */

.head {
  margin-bottom: var(--sp-4);
}

.combo-row {
  flex-wrap: wrap;
}

/* ------------------------------ 结算 ------------------------------ */

.result-card {
  text-align: center;
  padding: var(--sp-5) var(--sp-4);
}

.stars {
  display: flex;
  justify-content: center;
  gap: var(--sp-2);
  margin: var(--sp-3) 0;
}

.star {
  font-size: 72rpx;
  line-height: 1;
  color: var(--c-star-empty);
}

.star.is-on {
  color: var(--c-star);
  animation: pop 240ms ease-out;
}

.result-title {
  display: block;
  font-size: var(--fs-xl);
  font-weight: 500;
  color: var(--c-text);
}

/* ------------------------------ 错题 ------------------------------ */

.wrong-card {
  margin-top: var(--sp-3);
}

.wrong-list {
  margin-top: var(--sp-2);
}

.wrong-item {
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--c-border);
}

.wrong-item:last-child {
  border-bottom: none;
}

.wrong-line {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.wrong-toggle {
  margin-left: auto;
  font-size: var(--fs-xs);
  color: var(--c-primary);
}

.wrong-analysis {
  display: block;
  margin-top: var(--sp-2);
  padding: var(--sp-2);
  border-radius: var(--r-sm);
  background: var(--c-bg-sunken);
  font-size: var(--fs-sm);
  line-height: 1.7;
  color: var(--c-text-2);
}

.wrong-note {
  display: block;
  margin-top: var(--sp-2);
}

/* ------------------------------ 提示条 ------------------------------ */

.banner {
  padding: var(--sp-3);
  border-radius: var(--r-md);
  margin-bottom: var(--sp-3);
}

.banner-warn {
  background: var(--c-danger-weak);
  border: 1rpx solid var(--c-danger);
}

.banner-title {
  display: block;
  font-size: var(--fs-sm);
  font-weight: 500;
  color: var(--c-danger);
  margin-bottom: var(--sp-1);
}

.cleared-note {
  display: block;
  margin-top: var(--sp-1);
  color: var(--c-success);
}

.act-btn {
  width: 100%;
  margin-top: var(--sp-3);
}
